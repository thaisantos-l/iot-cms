# Versionar wp-content, documentação e este arquivo de regras.
/*
!/.gitignore
!/.gitattributes
!/wp-content/
!/docs/
!/scripts/
!/ops/
/ops/config*.json
!/tests/
!/.github/
!/package.json
!/package-lock.json
!/composer.json
!/composer.lock
!/.nvmrc
!/eslint.config.mjs
!/stylelint.config.mjs
!/phpcs.xml.dist
!/playwright.config.mjs

# Assets compilados acompanham o código para instalação via git pull.
# Ferramentas e pacotes de distribuição continuam fora do Git.
/wp-content/themes/iotnest/assets/.build-*/
/wp-content/plugins/iotnest-core/assets/.build-*/
/vendor/
/artifacts/
/test-results/
/playwright-report/

# Midias enviadas pelo WordPress.
/wp-content/uploads/
/wp-content/upload/

# Cache, atualizacoes, logs e backups gerados em execucao.
/wp-content/cache/
/wp-content/upgrade/
/wp-content/upgrade-temp-backup/
/wp-content/languages/
/wp-content/backups/
/wp-content/backup-db/
/wp-content/updraft/
/wp-content/ai1wm-backups/
/wp-content/wpvividbackups/
/wp-content/wflogs/
/wp-content/litespeed/
/wp-content/advanced-cache.php
/wp-content/object-cache.php
/wp-content/wp-cache-config.php
*.log
*.sql
*.sql.gz
*.sql.zip
*.sqlite
*.sqlite3
*.wpress
*.bak
*.backup

# Ambientes, credenciais e chaves privadas, inclusive em temas/plugins.
.env
.env.*
*.env
.envrc
.npmrc
.pypirc
.netrc
.ssh/
.aws/
credentials.json
service-account*.json
service_account*.json
secrets.json
secrets.*.json
auth.json
wp-config.php
wp-config-*.php
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa*
id_ed25519*

# Dependencias de desenvolvimento, caches de ferramentas e temporarios.
node_modules/
.npm/
.yarn/cache/
.sass-cache/
.cache/
coverage/
.phpunit.cache/
.phpunit.result.cache
.phpcs-cache
*.tmp
*.temp
*.swp
*.swo
*~

# Arquivos locais do sistema e dos editores.
.DS_Store
._*
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.sublime-workspace

# Dependência externa instalada pelo ambiente, fora do pacote próprio.
/wp-content/plugins/wordpress-seo/
/wp-content/plugins/wp-mail-smtp/
