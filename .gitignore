# Versionar somente wp-content e este arquivo de regras.
/*
!/.gitignore
!/wp-content/

# Midias enviadas pelo WordPress.
/wp-content/uploads/
/wp-content/upload/

# Cache, atualizacoes, logs e backups gerados em execucao.
/wp-content/cache/
/wp-content/upgrade/
/wp-content/upgrade-temp-backup/
/wp-content/languages/
/wp-content/backups/
/wp-content/backup-db/
/wp-content/updraft/
/wp-content/ai1wm-backups/
/wp-content/wpvividbackups/
/wp-content/wflogs/
/wp-content/litespeed/
/wp-content/advanced-cache.php
/wp-content/object-cache.php
/wp-content/wp-cache-config.php
*.log
*.sql
*.sql.gz
*.sql.zip
*.sqlite
*.sqlite3
*.wpress
*.bak
*.backup

# Ambientes, credenciais e chaves privadas, inclusive em temas/plugins.
.env
.env.*
*.env
.envrc
.npmrc
.pypirc
.netrc
.ssh/
.aws/
credentials.json
service-account*.json
service_account*.json
secrets.json
secrets.*.json
auth.json
wp-config.php
wp-config-*.php
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa*
id_ed25519*

# Dependencias de desenvolvimento, caches de ferramentas e temporarios.
node_modules/
.npm/
.yarn/cache/
.sass-cache/
.cache/
coverage/
.phpunit.cache/
.phpunit.result.cache
.phpcs-cache
*.tmp
*.temp
*.swp
*.swo
*~

# Arquivos locais do sistema e dos editores.
.DS_Store
._*
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.sublime-workspace
